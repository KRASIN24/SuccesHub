# Multi-stage backend image for SuccessHub (Spring Boot 3 / Java 21).
# Build from repo root: docker build -f Dockerfile.backend -t succeshub-backend .

FROM maven:3.9.9-eclipse-temurin-21 AS build
WORKDIR /workspace

COPY .mvn .mvn
COPY mvnw pom.xml ./
RUN chmod +x mvnw \
  && ./mvnw -B -q -DskipTests dependency:go-offline

COPY src ./src
RUN ./mvnw -B -DskipTests package \
  && mv target/succes-hub-*.jar /workspace/app.jar

FROM eclipse-temurin:21-jre-jammy
WORKDIR /app

RUN groupadd --system spring \
  && useradd --system --gid spring --no-create-home spring

COPY --from=build /workspace/app.jar /app/app.jar
USER spring:spring

EXPOSE 8082
ENTRYPOINT ["java", "-jar", "/app/app.jar"]

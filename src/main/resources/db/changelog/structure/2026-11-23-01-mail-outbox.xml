<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="
            http://www.liquibase.org/xml/ns/dbchangelog
            http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd"
        logicalFilePath="db/changelog/2026-11-23-01-mail-outbox.xml">

    <changeSet id="2026-11-23-01-mail-outbox" author="krasin">
        <createTable tableName="mail_outbox" schemaName="successhub">
            <column name="id" type="UUID">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="user_id" type="VARCHAR(255)"/>
            <column name="to_address" type="VARCHAR(320)">
                <constraints nullable="false"/>
            </column>
            <column name="subject" type="VARCHAR(200)">
                <constraints nullable="false"/>
            </column>
            <column name="template_name" type="VARCHAR(100)">
                <constraints nullable="false"/>
            </column>
            <column name="body_html" type="TEXT">
                <constraints nullable="false"/>
            </column>
            <column name="status" type="VARCHAR(20)">
                <constraints nullable="false"/>
            </column>
            <column name="attempt_count" type="INT" defaultValueNumeric="0">
                <constraints nullable="false"/>
            </column>
            <column name="max_attempts" type="INT" defaultValueNumeric="5">
                <constraints nullable="false"/>
            </column>
            <column name="last_error" type="VARCHAR(500)"/>
            <column name="next_attempt_at" type="TIMESTAMP WITH TIME ZONE">
                <constraints nullable="false"/>
            </column>
            <column name="created_at" type="TIMESTAMP WITH TIME ZONE" defaultValueComputed="NOW()">
                <constraints nullable="false"/>
            </column>
            <column name="sent_at" type="TIMESTAMP WITH TIME ZONE"/>
        </createTable>
        <createIndex tableName="mail_outbox" schemaName="successhub" indexName="idx_mail_outbox_due">
            <column name="status"/>
            <column name="next_attempt_at"/>
        </createIndex>
        <createIndex tableName="mail_outbox" schemaName="successhub" indexName="idx_mail_outbox_user_created">
            <column name="user_id"/>
            <column name="created_at"/>
        </createIndex>
    </changeSet>
</databaseChangeLog>

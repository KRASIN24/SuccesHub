<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="
            http://www.liquibase.org/xml/ns/dbchangelog
            http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <changeSet id="2026-06-20-01-task-xp-awarded" author="cursor">
        <addColumn tableName="task" schemaName="succeshub">
            <column name="xp_awarded" type="BOOLEAN" defaultValueBoolean="false">
                <constraints nullable="false"/>
            </column>
        </addColumn>

        <sql>
            UPDATE succeshub.task t
            SET xp_awarded = true
            WHERE EXISTS (
                SELECT 1 FROM succeshub.xp_event e
                WHERE e.task_id = t.id AND e.user_id = t.user_id
            );
        </sql>

        <sql>
            CREATE UNIQUE INDEX IF NOT EXISTS idx_xp_event_user_task
            ON succeshub.xp_event (user_id, task_id)
            WHERE task_id IS NOT NULL;
        </sql>
    </changeSet>

</databaseChangeLog>

            <column name="tasks_required" valueNumeric="7"/>
        </insert>
        <insert tableName="achievement_definition" schemaName="succeshub">
            <column name="id" value="a1000000-0000-0000-0000-000000000005"/>
            <column name="key" value="SOVEREIGN"/>
            <column name="label" value="Sovereign"/>
            <column name="icon" value="military_tech"/>
            <column name="description" value="Reach level 50."/>
            <column name="xp_required" valueNumeric="50000"/>
        </insert>
    </changeSet>

</databaseChangeLog>

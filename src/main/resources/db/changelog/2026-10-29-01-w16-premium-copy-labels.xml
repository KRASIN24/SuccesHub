<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="
            http://www.liquibase.org/xml/ns/dbchangelog
            http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <!-- W16: display labels only — keys/enums stay stable; SPA i18n is source of truth for UI. -->
    <changeSet id="2026-10-29-01-w16-premium-copy-labels" author="krasin">
        <update tableName="achievement_definition" schemaName="succeshub">
            <column name="label" value="Apex"/>
            <where>key = 'SOVEREIGN'</where>
        </update>
        <update tableName="reward_definition" schemaName="succeshub">
            <column name="label" value="Initiated"/>
            <where>key = 'TITLE_INITIATED'</where>
        </update>
        <update tableName="reward_definition" schemaName="succeshub">
            <column name="label" value="Focused"/>
            <where>key = 'TITLE_SOVEREIGN_MIND'</where>
        </update>
        <update tableName="reward_definition" schemaName="succeshub">
            <column name="label" value="Unbroken"/>
            <where>key = 'TITLE_APEX_OPERATOR'</where>
        </update>
        <update tableName="reward_definition" schemaName="succeshub">
            <column name="label" value="Relentless"/>
            <where>key = 'TITLE_RELENTLESS'</where>
        </update>
        <update tableName="reward_definition" schemaName="succeshub">
            <column name="label" value="Veteran"/>
            <where>key = 'TITLE_VETERAN'</where>
        </update>
    </changeSet>
</databaseChangeLog>

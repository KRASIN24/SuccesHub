<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="
            http://www.liquibase.org/xml/ns/dbchangelog
            http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <changeSet id="2026-07-08-01-streak-day-override" author="cursor">
        <createTable tableName="streak_day_override" schemaName="succeshub">
            <column name="id" type="UUID">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="user_id" type="VARCHAR(255)">
                <constraints nullable="false"/>
            </column>
            <column name="day" type="DATE">
                <constraints nullable="false"/>
            </column>
            <column name="kind" type="VARCHAR(20)" defaultValue="SHIELDED">
                <constraints nullable="false"/>
            </column>
            <column name="created_at" type="TIMESTAMP WITH TIME ZONE" defaultValueComputed="NOW()">
                <constraints nullable="false"/>
            </column>
        </createTable>
        <addUniqueConstraint
                schemaName="succeshub"
                tableName="streak_day_override"
                columnNames="user_id, day"
                constraintName="uq_streak_day_override_user_day"/>
        <createIndex tableName="streak_day_override" schemaName="succeshub" indexName="idx_streak_day_override_user">
            <column name="user_id"/>
        </createIndex>
    </changeSet>

</databaseChangeLog>
